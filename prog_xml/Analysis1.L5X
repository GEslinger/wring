<Routine Name="R000_Safety" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(SeqSafe.31)[XIC(Local:1:I.Data.10) ,XIC(SeqSafe.0) ]OTE(SeqSafe.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(SeqSafe.0)[XIO(AnyStationRunning) ,XIC(SeqSafe.1) ][OTE(SeqSafe.1) ,OTE(InhibitStart.0) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(SeqSafe.1)TON(PowerOffTMR,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(PowerOffTMR.DN)XIC(Local:1:I.Data.0)[XIC(Local:1:I.Data.11) ,XIC(Local:2:O.Data.0) ]OTE(Local:2:O.Data.0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Local:1:I.Data.0)OTE(DoorIsOpen);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(Local:1:I.Data.11) ,XIO(Local:1:I.Data.0) ]OTE(SeqSafe.31);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Local:2:O.Data.0)XIC(Local:1:I.Data.1)XIC(Local:1:I.Data.7)OTE(SafetyOK);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R050_Press" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(DoorIsOpen)OTE(Seq.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Seq.0)XIO(Seq.31)[XIC(Local:1:I.Data.3) XIC(Local:1:I.Data.12) ,XIC(Seq.1) ]OTE(Seq.1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Seq.1)[XIC(Local:1:I.Data.2) ,XIC(Seq.2) ]OTE(Seq.2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Seq.2)[XIC(Local:1:I.Data.3) ,XIC(Seq.4) ]OTE(Seq.4);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Seq.4)MOV(1000,PassFailPress)OTE(Seq.31);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[OUTPUTS]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Seq.1)XIO(Seq.2)OTE(Local:2:O.Data.1);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Seq.2)XIO(Seq.4)OTE(Local:2:O.Data.2);]]>
</Text>
</Rung>
</RLLContent>
